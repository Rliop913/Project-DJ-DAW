[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Views/mixset_editing_workspace.gd" id="1"]

[node name="MixsetEditingWorkspace" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="TitleRow" type="HBoxContainer" parent="Margin/VBox"]
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="TrackTitleLabel" type="Label" parent="Margin/VBox/TitleRow"]
unique_name_in_owner = true
text = "Track: Untitled"
size_flags_horizontal = 3

[node name="AddAssetButton" type="Button" parent="Margin/VBox/TitleRow"]
unique_name_in_owner = true
text = "Add Asset Draft"

[node name="OpenAssetButton" type="Button" parent="Margin/VBox/TitleRow"]
unique_name_in_owner = true
text = "Open Selected Config"

[node name="ListsRow" type="HSplitContainer" parent="Margin/VBox"]
size_flags_vertical = 3

[node name="ReadyPanel" type="PanelContainer" parent="Margin/VBox/ListsRow"]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ReadyVBox" type="VBoxContainer" parent="Margin/VBox/ListsRow/ReadyPanel"]
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="ReadyLabel" type="Label" parent="Margin/VBox/ListsRow/ReadyPanel/ReadyVBox"]
text = "Ready Assets"

[node name="ReadyAssetList" type="ItemList" parent="Margin/VBox/ListsRow/ReadyPanel/ReadyVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="PendingPanel" type="PanelContainer" parent="Margin/VBox/ListsRow"]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="PendingVBox" type="VBoxContainer" parent="Margin/VBox/ListsRow/PendingPanel"]
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="PendingLabel" type="Label" parent="Margin/VBox/ListsRow/PendingPanel/PendingVBox"]
