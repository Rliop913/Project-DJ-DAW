[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Views/music_asset_config_workspace.gd" id="1"]
[ext_resource type="PackedScene" path="res://Modules/track_module.tscn" id="2"]

[node name="MusicAssetConfigWorkspace" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="HeaderRow" type="HBoxContainer" parent="Margin/VBox"]
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="AssetHeaderLabel" type="Label" parent="Margin/VBox/HeaderRow"]
unique_name_in_owner = true
text = "Asset: none"
size_flags_horizontal = 3

[node name="SaveStateLabel" type="Label" parent="Margin/VBox/HeaderRow"]
unique_name_in_owner = true
text = "latest"

[node name="ButtonsRow" type="HBoxContainer" parent="Margin/VBox"]
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="BrowseButton" type="Button" parent="Margin/VBox/ButtonsRow"]
unique_name_in_owner = true
text = "Browse Source"

[node name="RegisterButton" type="Button" parent="Margin/VBox/ButtonsRow"]
unique_name_in_owner = true
text = "PDJE Register"

[node name="RefreshWaveformButton" type="Button" parent="Margin/VBox/ButtonsRow"]
unique_name_in_owner = true
text = "Fetch Waveform"

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
size_flags_vertical = 3
size_flags_horizontal = 3

[node name="FormVBox" type="VBoxContainer" parent="Margin/VBox/Scroll"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="SourcePathLabel" type="Label" parent="Margin/VBox/Scroll/FormVBox"]
text = "Source Path"

[node name="SourcePathEdit" type="LineEdit" parent="Margin/VBox/Scroll/FormVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="TitleLabel" type="Label" parent="Margin/VBox/Scroll/FormVBox"]
text = "Track Title"

[node name="TitleEdit" type="LineEdit" parent="Margin/VBox/Scroll/FormVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="ComposerLabel" type="Label" parent="Margin/VBox/Scroll/FormVBox"]
text = "Composer"

[node name="ComposerEdit" type="LineEdit" parent="Margin/VBox/Scroll/FormVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="StartBpmLabel" type="Label" parent="Margin/VBox/Scroll/FormVBox"]
text = "Start BPM"

[node name="StartBpmEdit" type="LineEdit" parent="Margin/VBox/Scroll/FormVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="FirstBeatLabel" type="Label" parent="Margin/VBox/Scroll/FormVBox"]
text = "First Beat"

[node name="FirstBeatEdit" type="LineEdit" parent="Margin/VBox/Scroll/FormVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="BpmRowsLabel" type="Label" parent="Margin/VBox/Scroll/FormVBox"]
text = "BPM Transition Metadata"

[node name="BpmRowsEdit" type="TextEdit" parent="Margin/VBox/Scroll/FormVBox"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 140)

[node name="ValidationLabel" type="RichTextLabel" parent="Margin/VBox"]
unique_name_in_owner = true
bbcode_enabled = true
fit_content = true
autowrap_mode = 3
text = "Fill the required fields to unlock local draft save and PDJE registration."

[node name="WaveformLabel" type="Label" parent="Margin/VBox"]
text = "Waveform Preview"

[node name="WaveformPreview" parent="Margin/VBox" instance=ExtResource("2")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 180)

[node name="AutosaveTimer" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = false
autostart = false

[node name="BrowseDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
file_mode = 4
access = 2

[connection signal="pressed" from="Margin/VBox/ButtonsRow/BrowseButton" to="." method="_on_browse_button_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonsRow/RegisterButton" to="." method="_on_register_button_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonsRow/RefreshWaveformButton" to="." method="_on_refresh_waveform_button_pressed"]
[connection signal="text_changed" from="Margin/VBox/Scroll/FormVBox/SourcePathEdit" to="." method="_on_field_changed"]
[connection signal="text_changed" from="Margin/VBox/Scroll/FormVBox/TitleEdit" to="." method="_on_field_changed"]
[connection signal="text_changed" from="Margin/VBox/Scroll/FormVBox/ComposerEdit" to="." method="_on_field_changed"]
[connection signal="text_changed" from="Margin/VBox/Scroll/FormVBox/StartBpmEdit" to="." method="_on_field_changed"]
[connection signal="text_changed" from="Margin/VBox/Scroll/FormVBox/FirstBeatEdit" to="." method="_on_field_changed"]
[connection signal="text_changed" from="Margin/VBox/Scroll/FormVBox/BpmRowsEdit" to="." method="_on_field_changed"]
